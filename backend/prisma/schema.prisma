generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// GRADE_6 was formerly QADIMGI_DUNYO (renamed in-place via a migration that
// preserves all existing Test rows — see migrations/20260715_period_grades).
// ORTA_ASRLAR/YANGI_DAVR/ENG_YANGI_DAVR are legacy values no longer used by
// the app (verified zero Test rows referenced them at migration time);
// Postgres can't drop enum values without a full type rebuild, so they're
// left in place inert rather than referenced anywhere in app code.
enum Period {
  GRADE_6
  ORTA_ASRLAR
  YANGI_DAVR
  ENG_YANGI_DAVR
  GRADE_7_JAHON
  GRADE_7_UZBEKISTON
  GRADE_8_JAHON
  GRADE_8_UZBEKISTON
  GRADE_9_JAHON
  GRADE_9_UZBEKISTON
  GRADE_10_JAHON
  GRADE_10_UZBEKISTON
  GRADE_11_JAHON
  GRADE_11_UZBEKISTON
}

enum CorrectOption {
  A
  B
  C
  D
}

enum SessionStatus {
  ACTIVE
  CLOSED
}

enum ExamStatus {
  PASSED
  FAILED
}

enum CertQuestionType {
  MCQ
  MATCHING
  OPEN
}

// No numeric/symbol identifiers allowed in Prisma enums, hence C_PLUS etc.
// NONE means the scaled score fell below the C threshold (46) — no
// certificate grade is awarded.
enum CertGrade {
  NONE
  C
  C_PLUS
  B
  B_PLUS
  A
  A_PLUS
}

enum Role {
  GUEST
  STUDENT
  ADMIN
}

// Legacy field, no longer required/used by the app now that every Period
// value already encodes its own grade+subject split (see Period enum above).
// Left in place unused rather than dropped — every existing Test row already
// has subCategory = null, so keeping the column is zero-risk.
enum SubCategory {
  UZBEKISTON
  JAHON
}

// role is a real, admin-manageable column (promote/demote + assign group via
// PATCH /students/:id). ADMIN_TELEGRAM_IDS remains a "break-glass" bootstrap:
// on every request, telegramAuth.ts force-upgrades (never downgrades) a
// matching account to ADMIN, so env-configured teachers can never be locked
// out even if their DB role is somehow wrong.
model Student {
  id                BigInt   @id @default(autoincrement())
  telegramId        BigInt   @unique
  fullName          String
  // False until the bot's mandatory name-registration conversation completes
  // (see bot/bot.ts) — every other bot command and the entire Mini App are
  // locked while this is false. Independent of role: a guest can be fully
  // registered (real name on file) while still awaiting an admin's promotion
  // to STUDENT.
  isRegistered      Boolean  @default(false)
  // True while the bot is waiting for the student's reply to /editname —
  // same one-field-as-conversation-state pattern as isRegistered above.
  awaitingNameEdit  Boolean  @default(false)
  // True while the bot is waiting for an admin's /sendall broadcast content.
  // Only ever set on rows env.adminTelegramIds recognizes as an admin.
  awaitingBroadcast Boolean  @default(false)
  username          String?
  role              Role     @default(GUEST)
  groupName         String?
  createdAt         DateTime @default(now())

  // Who invited this student via a /start ref_<telegramId> deep link — set
  // once, at row-creation time, never updated afterward (see bot/bot.ts's
  // registration gate). SetNull rather than cascading: deleting a referrer
  // must never delete the people they referred.
  referredById      BigInt?
  referredBy        Student?  @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals         Student[] @relation("Referrals")
  // How many brand-new users this student has successfully referred.
  // Incremented once per referred user, but only once that referred user is
  // confirmed subscribed to the mandatory channel (see bot/bot.ts) — reaching
  // REFERRAL_GOAL (10) while still GUEST auto-promotes to STUDENT +
  // groupName "Konkurs".
  referralCount     Int      @default(0)
  // True once this student's own referral has been counted toward their
  // referrer's referralCount — guards against double-crediting, since
  // channel-subscription confirmation can be reached via more than one code
  // path (see bot/bot.ts's creditReferralIfNeeded).
  referralCredited  Boolean  @default(false)

  testResults        TestResult[]
  attendanceRecords  AttendanceRecord[]
  examResults        ExamResult[]
  certificateResults CertificateResult[]

  @@index([referredById])
}

model Test {
  id          BigInt       @id @default(autoincrement())
  title       String
  period      Period
  subCategory SubCategory?
  isPublished Boolean      @default(false)
  // Free-preview topics: guests may view/take these even though every other
  // topic (and all exams) require student/admin. New topics default closed;
  // the teacher opts individual topics into the free tier via the admin
  // toggle (PUT /tests/:id { isFree }).
  isFree      Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  questions Question[]
  results   TestResult[]
}

model Question {
  id            BigInt        @id @default(autoincrement())
  testId        BigInt
  test          Test          @relation(fields: [testId], references: [id], onDelete: Cascade)
  questionText  String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer CorrectOption
  explanation   String?
  order         Int           @default(0)

  @@index([testId])
}

model TestResult {
  id         BigInt       @id @default(autoincrement())
  studentId  BigInt
  student    Student      @relation(fields: [studentId], references: [id])
  testId     BigInt
  test       Test         @relation(fields: [testId], references: [id], onDelete: Cascade)
  score      Int
  percentage Float
  createdAt  DateTime     @default(now())

  answers    TestAnswer[]

  @@index([studentId])
  @@index([testId])
}

// One row per question per submission, fully denormalized (question text/
// options/correctAnswer/explanation copied at submission time). questionId is
// an unenforced reference (no @relation) so editing/deleting a Question later
// never corrupts historical review data. Rows created before this model
// existed have no TestAnswer rows — review is "unavailable" for those, not
// backfilled (the original selections were never captured).
model TestAnswer {
  id             BigInt         @id @default(autoincrement())
  resultId       BigInt
  result         TestResult     @relation(fields: [resultId], references: [id], onDelete: Cascade)
  questionId     BigInt?
  order          Int
  questionText   String
  optionA        String
  optionB        String
  optionC        String
  optionD        String
  correctAnswer  CorrectOption
  explanation    String?
  selectedOption CorrectOption?
  isCorrect      Boolean

  @@index([resultId])
}

model AttendanceSession {
  id        BigInt        @id @default(autoincrement())
  title     String
  startTime DateTime      @default(now())
  endTime   DateTime
  status    SessionStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  // Which Student.groupName this session is for. Required going forward
  // (enforced in attendance.controller.ts, not here — Prisma has no native
  // conditional-required support, same pattern as Test.subCategory); nullable
  // only so pre-existing sessions created before this feature stay valid
  // ("ungated" — visible/markable regardless of group, see attendance.service.ts).
  groupName String?

  records AttendanceRecord[]
}

model AttendanceRecord {
  id        BigInt            @id @default(autoincrement())
  studentId BigInt
  student   Student           @relation(fields: [studentId], references: [id])
  sessionId BigInt
  session   AttendanceSession @relation(fields: [sessionId], references: [id])
  createdAt DateTime          @default(now())

  @@unique([studentId, sessionId])
  @@index([sessionId])
}

model Exam {
  id              BigInt    @id @default(autoincrement())
  title           String
  isPublished     Boolean   @default(false)
  durationMinutes Int?
  // Optional scheduling window (separate from durationMinutes, which is the
  // per-attempt countdown once a student starts): when set, the exam can
  // only be opened/submitted between startTime and endTime. NULL means no
  // restriction — existing exams are unaffected. Enforced in
  // exams.controller.ts (getExam/submitExam), bypassed entirely for admins.
  startTime       DateTime?
  endTime         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  questions ExamQuestion[]
  results   ExamResult[]
}

model ExamQuestion {
  id            BigInt        @id @default(autoincrement())
  examId        BigInt
  exam          Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionText  String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer CorrectOption
  explanation   String?
  order         Int           @default(0)

  @@index([examId])
}

model ExamResult {
  id             BigInt       @id @default(autoincrement())
  studentId      BigInt
  student        Student      @relation(fields: [studentId], references: [id])
  examId         BigInt
  exam           Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  score          Int
  totalQuestions Int
  percentage     Float
  status         ExamStatus
  createdAt      DateTime     @default(now())

  answers        ExamAnswer[]

  // A student may attempt a given exam exactly once — enforced here at the
  // DB level (not just app-level), same pattern as AttendanceRecord's
  // one-mark-per-session constraint.
  @@unique([studentId, examId])
  @@index([examId])
}

// Mirrors TestAnswer for exams — see TestAnswer doc comment above.
model ExamAnswer {
  id             BigInt         @id @default(autoincrement())
  resultId       BigInt
  result         ExamResult     @relation(fields: [resultId], references: [id], onDelete: Cascade)
  questionId     BigInt?
  order          Int
  questionText   String
  optionA        String
  optionB        String
  optionC        String
  optionD        String
  correctAnswer  CorrectOption
  explanation    String?
  selectedOption CorrectOption?
  isCorrect      Boolean

  @@index([resultId])
}

// Each value fully determines its top-level section too (no separate
// "category" column needed): DARSLIKLAR/MUHIM_QOLLANMALAR belong to
// "Qo'llanmalar", UMUMIY_SERTIFIKAT/MAVZULASHGAN_SERTIFIKAT to "Milliy
// Sertifikat Testlari" — the category grouping is a pure UI concern (see
// frontend/src/api/types.ts).
enum MaterialSection {
  DARSLIKLAR
  MUHIM_QOLLANMALAR
  UMUMIY_SERTIFIKAT
  MAVZULASHGAN_SERTIFIKAT
}

// Only meaningful for MAVZULASHGAN_SERTIFIKAT, which the student further
// narrows down by grade/subject before seeing a flat material list — every
// other section keeps its original flat list unchanged. Enforced at the app
// layer in materials.controller.ts (required when section is
// MAVZULASHGAN_SERTIFIKAT, forced to null otherwise), not a DB constraint,
// mirroring Test.subCategory's relationship with Period.
enum MaterialSubSection {
  GRADE_6
  GRADE_7_JAHON
  GRADE_7_UZBEKISTON
  GRADE_8_JAHON
  GRADE_8_UZBEKISTON
  GRADE_9_JAHON
  GRADE_9_UZBEKISTON
  GRADE_10_JAHON
  GRADE_10_UZBEKISTON
  GRADE_11_JAHON
  GRADE_11_UZBEKISTON
}

// Files are never stored on our server — fileId is a Telegram file_id,
// obtained by relaying the admin's upload through the bot (sendDocument to
// the uploading admin's own chat) and capturing the response. The same
// file_id is reusable by our bot to (re)send the file to any chat
// indefinitely, so "download" for a student means the bot delivering the
// document into their Telegram DM, not a browser download link — see
// materials.controller.ts's downloadMaterial.
model Material {
  id          BigInt          @id @default(autoincrement())
  title       String
  description String
  section     MaterialSection
  subSection  MaterialSubSection?
  fileId      String
  fileName    String
  // "Bepul" when false — guests may download it too, same isFree/guest
  // paywall pattern as Test.isFree. "Pullik" when true — requires role
  // student/admin.
  isPremium   Boolean         @default(false)
  isPublished Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([section])
  @@index([subSection])
}

// The 45-question "Milliy Sertifikat" (National Certificate) format: Q1-32
// MCQ, Q33-35 matching, Q36-45 open-ended with a/b sub-answers. Deliberately
// a separate model family from Test/Exam rather than bolted onto them —
// those two are pure single-type-A-D MCQ end to end (grading, snapshots,
// review UI), and mixing in matching/open-ended there would mean every
// existing MCQ code path has to branch on a type it never actually sees.
model CertificateTest {
  id          BigInt   @id @default(autoincrement())
  title       String
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions CertificateQuestion[]
  results   CertificateResult[]
}

// One row per question regardless of type; only the fields relevant to
// `type` are populated (enforced in certificates.controller.ts, Prisma has
// no native discriminated-union column support — same pattern as
// Material.subSection). matchItems is `[{ label, correctOption }]` — pair
// count is admin-defined per question, not fixed at 6. maxPoints is
// precomputed at write time (1 for MCQ, matchItems.length for MATCHING, 1 or
// 2 for OPEN depending on whether sub-answer B is used) so the scoring
// service never has to re-derive "how many points is this worth" from type.
model CertificateQuestion {
  id     BigInt          @id @default(autoincrement())
  testId BigInt
  test   CertificateTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  type         CertQuestionType
  order        Int              @default(0)
  questionText String

  // MCQ only
  optionA       String?
  optionB       String?
  optionC       String?
  optionD       String?
  correctOption CorrectOption?

  // MATCHING only
  matchItems Json?

  // OPEN only — openLabelB/openAnswerB stay null for a single-part open
  // question (Q36-45 normally use both a and b).
  openLabelA  String?
  openAnswerA String?
  openLabelB  String?
  openAnswerB String?

  explanation String?
  maxPoints   Float   @default(1)

  @@index([testId])
}

// rawScore/maxPossible/percentage are the raw tally; logit/scaledScore/grade
// are the simplified Rasch-style proxy (see certificateScoring.service.ts):
// percentage -> logit via the standard logistic-odds transform, then
// scaledScore = 50 + 10*logit (a mean-50/SD-10 T-score rescale), clamped to
// [0,100] and banded into `grade` per the fixed cutoff table. This is a
// placeholder curve, not a psychometrically calibrated 1PL Rasch fit (no
// per-item difficulty calibration data exists yet) — swap the transform in
// one place if/when real item-difficulty calibration becomes available.
model CertificateResult {
  id        BigInt          @id @default(autoincrement())
  studentId BigInt
  student   Student         @relation(fields: [studentId], references: [id])
  testId    BigInt
  test      CertificateTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  rawScore    Float
  maxPossible Float
  percentage  Float
  logit       Float
  scaledScore Float
  grade       CertGrade
  createdAt   DateTime  @default(now())

  answers CertificateAnswer[]

  @@index([studentId])
  @@index([testId])
}

// Denormalized per-question snapshot, same rationale as TestAnswer/
// ExamAnswer above (questionId is an unenforced reference so editing/
// deleting a live question never corrupts historical review data).
// selectedMatches mirrors matchItems' shape but with the student's chosen
// CorrectOption per label; studentAnswerA/B hold the student's raw
// (unnormalized) open-ended text as typed, separate from the openAnswerA/B
// key snapshot, so the review screen can show "you wrote X, key was Y".
model CertificateAnswer {
  id         BigInt            @id @default(autoincrement())
  resultId   BigInt
  result     CertificateResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  questionId BigInt?
  order      Int
  type       CertQuestionType

  questionText String

  optionA        String?
  optionB        String?
  optionC        String?
  optionD        String?
  correctOption  CorrectOption?
  selectedOption CorrectOption?

  matchItems      Json?
  selectedMatches Json?

  openLabelA     String?
  openAnswerA    String?
  studentAnswerA String?
  openLabelB     String?
  openAnswerB    String?
  studentAnswerB String?

  explanation  String?
  pointsEarned Float
  maxPoints    Float
  isCorrect    Boolean

  @@index([resultId])
}
